# OAuth client credentials: replace placeholders only in your local .env.
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret

# Initial setup only. This code is short-lived and removed after exchange.
ZOHO_AUTH_CODE=

# Saved by DEApp after the first successful authorization-code exchange.
# Leave blank for the first setup run.
ZOHO_REFRESH_TOKEN=

# Set these to the Zoho data center and OAuth application registration.
ZOHO_ACCOUNTS_SERVER=https://accounts.zoho.com
ZOHO_MAIL_API_BASE=https://mail.zoho.com/api
ZOHO_REDIRECT_URI=your_registered_redirect_uri

# Optional when Zoho returns exactly one account. Required if several return.
ZOHO_ACCOUNT_ID=

ZOHO_TIMEOUT_SECONDS=30