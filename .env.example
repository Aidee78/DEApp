# Zoho client ID is an application identifier, not a secret.
ZOHO_CLIENT_ID=your_client_id

# Set these to the Zoho data center and the exact redirect URI registered
# for the desktop OAuth client. OAuth tokens are stored in Windows Credential
# Manager by scripts/authorize_zoho.py, not in this file.
ZOHO_ACCOUNTS_SERVER=https://accounts.zoho.com
ZOHO_MAIL_API_BASE=https://mail.zoho.com/api
ZOHO_REDIRECT_URI=your_registered_redirect_uri

# Optional when Zoho returns exactly one account. Required if several return.
ZOHO_ACCOUNT_ID=

ZOHO_TIMEOUT_SECONDS=30

# Dropbox app key is an identifier; the refresh token is stored in Windows
# Credential Manager by scripts/authorize_dropbox.py and does not belong here.
DROPBOX_APP_KEY=your_dropbox_app_key
